            "body": {
              "mode": "raw",
              "raw": "{\n  \"responseText\": \"Maintenance crew has inspected and replaced the filtration unit.\",\n  \"statusUpdate\": \"RESOLVED\",\n  \"remarks\": \"Filters replaced and water cleared\"\n}"
            },
            "url": "http://localhost:8080/api/authority/reports/GW-2026-WGJDTL/response"
          }
        }
      ]
    },
