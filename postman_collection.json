      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ghostwrite.com\",\n  \"password\": \"GhostWrite@2026\"\n}"
            },
            "url": "http://localhost:8080/api/auth/login"
          }
        },
        {
          "name": "Authority Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"authority@ghostwrite.com\",\n  \"password\": \"GhostWrite@2026\"\n}"
            },
            "url": "http://localhost:8080/api/auth/login"
          }
        },
        {
          "name": "Reviewer Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"reviewer@ghostwrite.com\",\n  \"password\": \"GhostWrite@2026\"\n}"
            },
            "url": "http://localhost:8080/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "2. AI Ghost Writer",
      "item": [
        {
          "name": "Get AI Engine Status",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/ghostwriter/status"
          }
        },
        {
          "name": "Generate Professional Grievance",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rawDescription\": \"Hostel water in Block A 2nd floor is completely yellow and murky with bad odor. Caretaker was informed twice with no response.\",\n  \"category\": \"Hostel\",\n  \"reporterType\": \"STUDENT\",\n  \"location\": \"Hostel Block A 2nd Floor\"\n}"
            },
            "url": "http://localhost:8080/api/ghostwriter/generate"
          }
        },
        {
          "name": "Analyze & Classify Grievance",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rawDescription\": \"Campus Wi-Fi connectivity in Science Block drops every 5 minutes during lab hours.\",\n  \"category\": \"Technology / IT\"\n}"
            },
            "url": "http://localhost:8080/api/ai/analyze"
          }
        }
      ]
    },
    {
      "name": "3. Anonymous Reporting & Tracking",
      "item": [
        {
          "name": "Submit Anonymous Report",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reporterType\": \"STUDENT\",\n  \"category\": \"Hostel\",\n  \"severity\": \"HIGH\",\n  \"rawDescription\": \"Hostel water in Block A 2nd floor is completely yellow and murky with bad odor.\",\n  \"location\": \"Hostel Block A 2nd Floor\",\n  \"acceptedProfessionalTitle\": \"Formal Representation: Immediate Intervention Required for Hostel Water Supply\",\n  \"acceptedExecutiveSummary\": \"Persistent contamination observed in dormitory plumbing fixtures posing sanitary risks.\",\n  \"acceptedDetailedDescription\": \"Factual record demonstrates unresolved water discoloration affecting resident health.\",\n  \"acceptedRequestedAction\": \"Immediate technical inspection and corrective plumbing overhaul within 24 hours.\",\n  \"acceptedSuggestedPriority\": \"P2\",\n  \"acceptedSuggestedDepartment\": \"Hostel Administration & Estate Office\"\n}"
            },
            "url": "http://localhost:8080/api/reports/anonymous"
          }
        },
        {
          "name": "Track Report by Token",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/reports/track/GW-2026-WGJDTL?token=TK-DEMO-SAMPLE-HOST",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "reports", "track", "GW-2026-WGJDTL"],
              "query": [{ "key": "token", "value": "TK-DEMO-SAMPLE-HOST" }]
            }
          }
        },
        {
          "name": "Post Anonymous Message",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messageText\": \"When will the technical maintenance crew arrive?\",\n  \"trackingToken\": \"TK-DEMO-SAMPLE-HOST\"\n}"
            },
            "url": "http://localhost:8080/api/reports/GW-2026-WGJDTL/messages"
          }
        },
        {
          "name": "View Formal Document Dossier",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/documents/GW-2026-WGJDTL/view"
          }
        }
      ]
    },
    {
      "name": "4. Admin & Governance",
      "item": [
        {
          "name": "Get Dashboard KPIs",
