          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "http://localhost:8080/api/admin/reports?page=0&size=15"
          }
        },
        {
          "name": "Get Report Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": "http://localhost:8080/api/admin/reports/GW-2026-WGJDTL"
          }
        },
        {
          "name": "Update Report Status",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"remarks\": \"Assigned to engineering inspection team\"\n}"
            },
            "url": "http://localhost:8080/api/admin/reports/GW-2026-WGJDTL/status"
          }
        }
      ]
